{
  "name": "cmc-lab",
  "version": "2.0.1",
  "private": false,
  "description": "全国大学生数学竞赛（CMC）备考助手：真题练习、限时模考、错题复盘、知识模块追踪、公式速查",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "数学竞赛",
    "CMC",
    "大学生数学竞赛",
    "考研数学",
    "刷题",
    "react",
    "typescript",
    "capacitor",
    "pwa"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "validate": "node scripts/validate-bank.cjs",
    "probe:cloud": "node scripts/e2e-cloud.mjs",
    "format": "prettier --write .",
    "cap:sync": "vite build && cap sync",
    "cap:android": "vite build && cap sync android && cap open android",
    "cap:ios": "vite build && cap sync ios && cap open ios"
  },
  "dependencies": {
    "@tencent-ai/workbuddy-cloud-sdk": "dev",
    "katex": "^0.16.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.7",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
